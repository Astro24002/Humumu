# Server
SERVER_PORT=8080

# Database — async DSN for SQLAlchemy/asyncpg (required for the API)
# Form: postgresql+asyncpg://user:pass@host:port/dbname
# Do NOT use postgres:// or ?sslmode=... with asyncpg — those break the async driver.
DB_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/journal_monitor
# Sync DSN for migrations (psycopg2). If empty, derived from DB_DSN by stripping +asyncpg.
DB_DSN_SYNC=postgresql://postgres:postgres@localhost:5432/journal_monitor

# Redis host:port
REDIS_ADDR=localhost:6379

# SMTP (optional; leave blank to disable email)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=notifications@example.com

# WeChat Mini Program
WECHAT_APPID=
WECHAT_SECRET=
WECHAT_TEMPLATE_REALTIME=
WECHAT_TEMPLATE_DAILY=

# Auth — required at runtime (must not be empty)
JWT_SECRET=change-me-to-something-secure

# Background fetch interval
FETCH_INTERVAL_MINUTES=30

# Fetch/notify scheduler (1=on). Default off in app code for tests;
# Docker entrypoint sets HUMUMU_ENABLE_SCHEDULER=1 unless overridden.
HUMUMU_ENABLE_SCHEDULER=0

# Upsert journals + CAS facets after migrate (1=on). Off by default.
HUMUMU_SEED_JOURNALS=0

# Static web dist path
WEB_DIST=web/dist
